      "order": 2
    },
    {
      "id": "page3",
      "title": "Student Support",
      "order": 3
    }
  ],
  "categories": [
    {
      "id": "teaching-quality",
      "pageId": "page1",
      "parentId": null,
      "title": "Teaching Quality",
      "order": 1
    },
    {
      "id": "course-content",
      "pageId": "page1",
      "parentId": "teaching-quality",
      "title": "Course Content",
      "order": 1
    },
    {
      "id": "campus-facilities",
      "pageId": "page2",
      "parentId": null,
      "title": "Campus Facilities",
      "order": 1
    },
    {
      "id": "study-spaces",
      "pageId": "page2",
